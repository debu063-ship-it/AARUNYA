# ============================================
# Aarunya E-Commerce — Environment Configuration
# ============================================
# Copy this file to .env and fill in values.

# Database (optional — app works without it using file-based storage)
# DATABASE_URL=mysql://user:password@localhost:3306/aarunya

# Admin Security
ADMIN_PASSWORD=admin123
ADMIN_NOTIFICATION_EMAIL=debangshumondal7@gmail.com

# ============================================
# Email Notifications (SMTP)
# ============================================
# To receive order notifications on your email:
#
# For Gmail:
#   1. Enable 2-Step Verification: https://myaccount.google.com/security
#   2. Generate App Password: https://myaccount.google.com/apppasswords
#   3. Use that 16-character password as SMTP_PASS
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=debangshumondal7@gmail.com
# SMTP_PASS=your-16-char-app-password
