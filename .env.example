# ===========================================
# Aarunya — Environment Variables
# ===========================================
# Copy this file to .env and fill in your values.

# Supabase (required)
# Get these from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# These are exposed to the client (Vite requires VITE_ prefix)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Database — Supabase PostgreSQL connection string
# Get from: Supabase Dashboard → Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Admin email — this email gets the "admin" role automatically
ADMIN_EMAIL=debangshumondal7@gmail.com

# Email notifications (optional — order notification emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
ADMIN_NOTIFICATION_EMAIL=debangshumondal7@gmail.com

# Razorpay Payment Gateway (required for checkout)
# Get these from: https://dashboard.razorpay.com/app/keys
# In Test mode use rzp_test_... and in Live mode use rzp_live_...
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Delhivery Logistics & Express Shipping
# Get API Token from: Delhivery Unified Client Portal / Delhivery One (Settings → API)
DELHIVERY_API_TOKEN=your-delhivery-api-token
# Registered Warehouse / Pickup Location name configured in Delhivery Portal
DELHIVERY_PICKUP_LOCATION=Primary Warehouse
DELHIVERY_CLIENT_NAME=Aarunya
# Mode: "staging" for sandbox testing, "production" for live shipments
DELHIVERY_MODE=staging

# Server
PORT=3000
NODE_ENV=development
